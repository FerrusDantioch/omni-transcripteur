{
  "id": "/omni-transcripteur/",
  "name": "Omni-Transcripteur",
  "short_name": "Omni-Transcripteur",
  "description": "Transforme la voix en texte, directement sur ton appareil, même hors ligne.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14111d",
  "theme_color": "#1d1929",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?partage=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".wav",
            ".m4a",
            ".ogg",
            ".oga",
            ".opus",
            ".webm",
            ".aac",
            ".flac",
            ".mp4",
            ".mov",
            ".mkv",
            ".m4v"
          ]
        }
      ]
    }
  }
}
